// "Create QR code" window: turns text or a link into a QR code to scan with a phone.

import { Button, ComboBox, TextEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

export component GeneratorWindow inherits Window {
    title: @tr("QRcode tool — Create QR code");
    icon: Icons.logo;
    min-width: 640px;
    min-height: 440px;
    preferred-width: 760px;
    preferred-height: 500px;
    background: Theme.bg;
    property <bool> dark: Theme.dark;

    in-out property <string> text;
    // 0 L (7 %), 1 M (15 %), 2 Q (25 %), 3 H (30 %)
    in-out property <int> ec-level: 1;
    in property <image> preview;
    // 0 empty, 1 ok, 2 too long
    in property <int> state: 0;
    in property <int> modules: 0;
    // short confirmation shown under the buttons ("Copied", "Saved")
    in property <string> feedback;

    callback text-edited(string);
    callback ec-changed(int);
    callback copy-image();
    callback save-png();
    callback save-svg();
    callback close-requested();

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        input.focus();
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    FocusScope {
        key-released(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            // Escape acts on release: some input methods swallow the key-down.
            if (event.text == Key.Escape) {
                return accept;
            }
            reject
        }

        HorizontalLayout {
            padding: 20px;
            spacing: 20px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;
                Text {
                    text: @tr("Text or link");
                    color: Theme.text;
                    font-size: Theme.body;
                    font-weight: 600;
                }
                input := TextEdit {
                    vertical-stretch: 1;
                    wrap: word-wrap;
                    placeholder-text: @tr("Type or paste what the code should contain, for example https://example.com");
                    text <=> root.text;
                    edited(t) => {
                        root.text-edited(t);
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: @tr("Error correction");
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: [@tr("Low — smallest code"), @tr("Medium — recommended"), @tr("Quartile"), @tr("High — survives damage or a logo")];
                        current-index <=> root.ec-level;
                        selected => {
                            root.ec-changed(self.current-index);
                        }
                    }
                }
                Text {
                    text: @tr("{} characters", root.text.character-count);
                    color: Theme.text-tertiary;
                    font-size: Theme.caption;
                }
            }

            VerticalLayout {
                width: 300px;
                spacing: 12px;
                Rectangle {
                    width: 300px;
                    height: 300px;
                    background: #ffffff;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.stroke-strong;
                    if root.state == 1: Image {
                        width: 276px;
                        height: 276px;
                        source: root.preview;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: @tr("QR code preview");
                    }
                    if root.state != 1: VerticalLayout {
                        alignment: center;
                        padding: 24px;
                        spacing: 10px;
                        Image {
                            source: root.state == 2 ? Icons.warning : Icons.qr;
                            width: 48px;
                            height: 48px;
                            colorize: root.state == 2 ? #9d5d00 : #00000040;
                        }
                        Text {
                            text: root.state == 2 ? @tr("Too much text for one QR code. Shorten it or choose a lower error correction.") : @tr("The QR code appears here.");
                            color: #00000099;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
                if root.state == 1: Text {
                    text: @tr("{} × {} modules", root.modules, root.modules);
                    color: Theme.text-tertiary;
                    font-size: Theme.caption;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        horizontal-stretch: 1;
                        text: @tr("Copy image");
                        icon: Icons.copy;
                        colorize-icon: true;
                        primary: true;
                        enabled: root.state == 1;
                        clicked => {
                            root.copy-image();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        horizontal-stretch: 1;
                        text: @tr("Save PNG…");
                        icon: Icons.save;
                        colorize-icon: true;
                        enabled: root.state == 1;
                        clicked => {
                            root.save-png();
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        text: @tr("Save SVG…");
                        icon: Icons.save;
                        colorize-icon: true;
                        enabled: root.state == 1;
                        clicked => {
                            root.save-svg();
                        }
                    }
                }
                Text {
                    text: root.feedback;
                    color: Theme.success;
                    font-size: Theme.caption;
                    horizontal-alignment: center;
                }
                Rectangle { }
            }
        }
    }
}
