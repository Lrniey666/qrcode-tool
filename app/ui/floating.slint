// Floating toolbar (mode C) and the collapsed floating bubble.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { IconButton, ToolbarSeparator } from "widgets.slint";

// Hover text for the toolbar's hint row: the toolbar window is too small for pop-up
// tooltips, so the description of the hovered button is shown in a second row instead.
component BarButton inherits IconButton {
    show-tooltip: false;
    size: 38px;
}

// One toolbar button. `group-start` draws a separator before it.
struct BarItem {
    id: string,
    icon: image,
    label: string,
    enabled: bool,
    group-start: bool,
}

// The drag handle. Rotated by 90° in the vertical toolbar.
component Grip inherits Rectangle {
    in property <bool> vertical;
    callback drag-start();
    callback hover-changed(bool);
    width: root.vertical ? 38px : 22px;
    height: root.vertical ? 22px : 38px;
    Image {
        source: Icons.grip;
        width: 18px;
        height: 18px;
        transform-rotation: root.vertical ? 90deg : 0deg;
        colorize: Theme.text-tertiary;
    }
    ta := TouchArea {
        mouse-cursor: move;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag-start();
            }
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
    }
}

export component ToolbarWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "QRcode tool";
    icon: Icons.logo;
    // Transparent window with a rounded card inside (falls back to square corners on
    // systems without a compositor).
    background: transparent;
    // Fixed sizes: binding the window to the layout's preferred size cycles with the hint
    // text and can shrink the window until the bubble and close buttons are clipped.
    // Row: grip 22 + 10×38 + 2 separators + 12×2 gaps = 428, plus padding and room for
    // the hint. Column: the same buttons stacked, with a two-line hint below them.
    min-width: root.vertical ? 64px : 460px;
    min-height: root.vertical ? 536px : 80px;
    preferred-width: root.vertical ? 64px : 460px;
    preferred-height: root.vertical ? 536px : 80px;

    // Set by Rust before the window is shown: a column at the screen edge instead of a row.
    in property <bool> vertical: false;
    in property <bool> camera-available: true;
    in property <string> hotkey-screen;
    in property <string> hotkey-region;
    in property <string> hotkey-camera;
    property <bool> dark: Theme.dark;

    // scan-screen | scan-region | camera | clipboard | image | generate | history | settings | collapse | close
    // `collapse` switches to the bubble. `close` dismisses the floating UI and must not
    // bring the bubble back.
    callback action(string);
    callback drag-start();

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    pure function label-for(id: string) -> string {
        if (id == "scan-screen") { return @tr("Scan whole screen"); }
        if (id == "scan-region") { return @tr("Select area"); }
        if (id == "camera") { return @tr("Scan with camera"); }
        if (id == "clipboard") { return @tr("Scan image from clipboard"); }
        if (id == "image") { return @tr("Open image…"); }
        if (id == "generate") { return @tr("Create QR code…"); }
        if (id == "history") { return @tr("History"); }
        if (id == "settings") { return @tr("Settings"); }
        if (id == "collapse") { return @tr("Collapse to bubble"); }
        if (id == "close") { return @tr("Close toolbar"); }
        if (id == "grip") { return @tr("Drag to move"); }
        return "QRcode tool";
    }

    // The order of the buttons, the same in both layouts.
    property <[BarItem]> items: [
        { id: "scan-screen", icon: Icons.fullscreen, label: label-for("scan-screen"), enabled: true, group-start: false },
        { id: "scan-region", icon: Icons.region, label: label-for("scan-region"), enabled: true, group-start: false },
        { id: "camera", icon: Icons.camera, label: label-for("camera"), enabled: root.camera-available, group-start: false },
        { id: "clipboard", icon: Icons.clipboard, label: label-for("clipboard"), enabled: true, group-start: false },
        { id: "image", icon: Icons.image, label: label-for("image"), enabled: true, group-start: false },
        { id: "generate", icon: Icons.qr, label: label-for("generate"), enabled: true, group-start: true },
        { id: "history", icon: Icons.history, label: label-for("history"), enabled: true, group-start: false },
        { id: "settings", icon: Icons.settings, label: label-for("settings"), enabled: true, group-start: false },
        // Bubble icon: collapse. X: close. They must stay distinct.
        { id: "collapse", icon: Icons.bubble, label: label-for("collapse"), enabled: true, group-start: true },
        { id: "close", icon: Icons.close, label: label-for("close"), enabled: true, group-start: false },
    ];

    // Id of the hovered button ("grip" for the handle, "" for none).
    property <string> hover-id;
    property <string> hint-title: label-for(root.hover-id);
    property <string> hint-key: root.hover-id == "scan-screen" ? root.hotkey-screen : root.hover-id == "scan-region" ? root.hotkey-region : root.hover-id == "camera" ? root.hotkey-camera : "";

    function set-hover(id: string, on: bool) {
        if (on) {
            root.hover-id = id;
        } else if (root.hover-id == id) {
            root.hover-id = "";
        }
    }

    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.stroke-strong;
    }

    // ── Row (default): buttons on top, hint text underneath ──
    if !root.vertical: VerticalLayout {
        padding: 6px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 2px;
            min-width: 428px;
            Grip {
                vertical: false;
                drag-start => {
                    root.drag-start();
                }
                hover-changed(on) => {
                    root.set-hover("grip", on);
                }
            }
            for item in root.items: HorizontalLayout {
                spacing: 2px;
                if item.group-start: ToolbarSeparator {
                    y: (parent.height - self.height) / 2;
                }
                BarButton {
                    icon: item.icon;
                    label: item.label;
                    enabled: item.enabled;
                    clicked => {
                        root.action(item.id);
                    }
                    hover-changed(on) => {
                        root.set-hover(item.id, on);
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            height: 22px;
            spacing: 6px;
            Text {
                text: root.hint-title;
                font-size: Theme.caption;
                color: Theme.text-secondary;
                vertical-alignment: center;
                // Cap the hint so a long translation cannot widen the row and push the
                // bubble / close buttons past the window edge.
                max-width: 280px;
                overflow: elide;
            }
            if root.hint-key != "": Text {
                text: root.hint-key;
                font-size: Theme.caption;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }

    // ── Column: buttons stacked, the hovered button's name underneath ──
    if root.vertical: VerticalLayout {
        padding: 6px;
        spacing: 2px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Grip {
                vertical: true;
                drag-start => {
                    root.drag-start();
                }
                hover-changed(on) => {
                    root.set-hover("grip", on);
                }
            }
        }
        for item in root.items: VerticalLayout {
            spacing: 2px;
            if item.group-start: Rectangle {
                height: 9px;
                Rectangle {
                    width: 20px;
                    height: 1px;
                    background: Theme.stroke-strong;
                }
            }
            HorizontalLayout {
                alignment: center;
                BarButton {
                    icon: item.icon;
                    label: item.label;
                    enabled: item.enabled;
                    clicked => {
                        root.action(item.id);
                    }
                    hover-changed(on) => {
                        root.set-hover(item.id, on);
                    }
                }
            }
        }
        Rectangle {
            height: 4px;
        }
        // Too narrow for a tooltip, so the name wraps onto up to three short lines.
        Text {
            height: 46px;
            text: root.hover-id != "" ? root.hint-title : "";
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            overflow: elide;
        }
        if root.hint-key != "": Text {
            text: root.hint-key;
            font-size: 10px;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component BubbleWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "QRcode tool";
    icon: Icons.logo;
    background: transparent;
    width: 48px;
    height: 48px;

    in property <bool> camera-available: true;
    // click: toolbar. long-press: scan-screen.
    // menu: scan-screen | scan-region | camera | clipboard | toolbar | hide
    callback action(string);
    callback drag-start();

    property <length> press-x;
    property <length> press-y;
    property <bool> moved-far: false;
    property <bool> holding: false;
    // Set when the long-press already started a scan, so the release is not also a click.
    property <bool> long-fired: false;

    Rectangle {
        x: 4px;
        y: 4px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: root.holding && !root.moved-far ? Theme.selected : ta.has-hover ? Theme.surface-alt : Theme.surface;
        border-width: 2px;
        border-color: root.holding && !root.moved-far ? Theme.accent-fg : ta.has-hover ? Theme.accent-fg : Theme.stroke-strong;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.shadow;
        Image {
            source: Icons.logo;
            width: 26px;
            height: 26px;
        }
    }

    // A short click opens the toolbar. Holding still scans the screen.
    Timer {
        interval: 500ms;
        running: root.holding && !root.moved-far && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.holding = false;
            root.action("scan-screen");
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.moved-far = false;
                root.long-fired = false;
                root.holding = true;
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.holding = false;
            }
        }
        moved => {
            if (self.pressed && !root.moved-far && (abs(self.mouse-x - root.press-x) > 4px || abs(self.mouse-y - root.press-y) > 4px)) {
                root.moved-far = true;
                root.holding = false;
                root.drag-start();
            }
        }
        clicked => {
            if (!root.moved-far && !root.long-fired) {
                root.action("toolbar");
            }
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Scan whole screen");
                activated => {
                    root.action("scan-screen");
                }
            }
            MenuItem {
                title: @tr("Select area");
                activated => {
                    root.action("scan-region");
                }
            }
            MenuItem {
                title: @tr("Scan with camera");
                enabled: root.camera-available;
                activated => {
                    root.action("camera");
                }
            }
            MenuItem {
                title: @tr("Scan image from clipboard");
                activated => {
                    root.action("clipboard");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Show toolbar");
                activated => {
                    root.action("toolbar");
                }
            }
            MenuItem {
                title: @tr("Hide bubble");
                activated => {
                    root.action("hide");
                }
            }
        }
    }
}
