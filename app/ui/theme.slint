// Design tokens for QRcode tool — Windows 11 / Fluent inspired.
// Rust pushes `dark`, `accent` and `high-contrast` into every window; everything else
// is derived here so all windows stay consistent.

export global Theme {
    in-out property <bool> dark: false;
    in-out property <color> accent: #1D4FFF;
    in-out property <bool> high-contrast: false;

    // Accent tuned for contrast on the current background.
    out property <color> accent-fg: dark ? accent.brighter(0.45) : accent;
    out property <color> accent-fill: dark ? accent.brighter(0.25) : accent;
    out property <color> on-accent: dark ? #000000 : #ffffff;

    // Surfaces
    out property <color> bg: dark ? #202020 : #f3f3f3;
    out property <color> surface: dark ? #2b2b2b : #ffffff;
    out property <color> surface-alt: dark ? #323232 : #f9f9f9;
    out property <color> card: dark ? #ffffff0d : #ffffffb3;
    out property <color> stroke: dark ? #ffffff14 : #0000000f;
    out property <color> stroke-strong: dark ? #ffffff2e : #00000026;
    out property <color> hover: dark ? #ffffff0f : #00000009;
    out property <color> pressed: dark ? #ffffff08 : #00000006;
    out property <color> selected: dark ? #ffffff14 : #0000000d;

    // Text
    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> text-secondary: dark ? #ffffffc5 : #000000a3;
    out property <color> text-tertiary: dark ? #ffffff87 : #00000073;

    // Status
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> warning-bg: dark ? #433519 : #fff4ce;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> danger-bg: dark ? #442726 : #fde7e9;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> info: dark ? #99ebff : #005fb7;

    // Lens-style pills on top of screenshots are always dark for legibility.
    out property <color> pill-bg: #1f1f1fe8;
    out property <color> pill-hover: #2d2d2df2;
    out property <color> pill-text: #ffffff;
    out property <color> pill-subtext: #ffffffb3;
    out property <color> scrim: #00000073;

    // Brand gradient (from the logo)
    out property <brush> brand: @linear-gradient(135deg, #1D4FFF 0%, #159FF0 46%, #19DFC2 100%);

    // Shape & type
    out property <length> radius-sm: 4px;
    out property <length> radius: 8px;
    out property <length> radius-lg: 12px;
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> body-strong: 14px;
    out property <length> subtitle: 20px;
    out property <length> title: 28px;

    out property <color> shadow: dark ? #00000080 : #00000033;
}

// Helpers that map a severity level (0 ok, 1 info, 2 warning, 3 danger) to colours.
export global Levels {
    public pure function fg(level: int) -> color {
        if (level >= 3) { return Theme.danger; }
        if (level == 2) { return Theme.warning; }
        return Theme.text-secondary;
    }
    public pure function pill-ring(level: int) -> color {
        if (level >= 3) { return #ff6b6b; }
        if (level == 2) { return #ffc83d; }
        return #ffffff00;
    }
}
