#: ui/overlay.slint:108
msgctxt "OverlayWindow"
msgid "Looking for codes…"
msgstr "Поиск кодов…"

#: ui/overlay.slint:109
msgctxt "OverlayWindow"
msgid "1 code found — press Enter to open, or click it"
msgstr "Найден 1 код — нажмите Enter или щёлкните его, чтобы открыть"

#: ui/overlay.slint:109
msgctxt "OverlayWindow"
msgid "{} codes found — click one, or use Tab and Enter"
msgstr "Найдено кодов: {} — щёлкните нужный или используйте Tab и Enter"

#: ui/overlay.slint:110
msgctxt "OverlayWindow"
msgid "No code found on the screen. Select an area to try again."
msgstr "На экране не найдено кодов. Выберите область и попробуйте снова."

#: ui/overlay.slint:111
msgctxt "OverlayWindow"
msgid "No code in that area. Try selecting a little more around it."
msgstr "В этой области нет кода. Попробуйте выделить немного больше вокруг него."

#: ui/overlay.slint:112
msgctxt "OverlayWindow"
msgid "Drag to select a QR code. Press Esc to cancel."
msgstr "Выделите QR-код, перетащив указатель. Нажмите Esc для отмены."

#: ui/overlay.slint:343
msgctxt "OverlayWindow"
msgid "Scan whole screen"
msgstr "Сканировать весь экран"

#: ui/overlay.slint:345
msgctxt "OverlayWindow"
msgid "Look for codes on the entire screen again."
msgstr "Снова искать коды на всём экране."

#: ui/overlay.slint:353
msgctxt "OverlayWindow"
msgid "Select area"
msgstr "Выделить область"

#: ui/overlay.slint:355
msgctxt "OverlayWindow"
msgid "Drag a box around the code you want to scan."
msgstr "Обведите код, который нужно сканировать."

#: ui/overlay.slint:366
msgctxt "OverlayWindow"
msgid "Scan with camera"
msgstr "Сканировать камерой"

#: ui/overlay.slint:368
msgctxt "OverlayWindow"
msgid "Hold a printed code or a phone screen up to your webcam."
msgstr "Поднесите напечатанный код или экран телефона к веб-камере."

#: ui/overlay.slint:375
msgctxt "OverlayWindow"
msgid "Scan image from clipboard"
msgstr "Сканировать изображение из буфера обмена"

#: ui/overlay.slint:376
msgctxt "OverlayWindow"
msgid "Reads a screenshot or picture you copied."
msgstr "Считывает скопированный снимок экрана или картинку."

#: ui/overlay.slint:383
msgctxt "OverlayWindow"
msgid "Open image…"
msgstr "Открыть изображение…"

#: ui/overlay.slint:384
msgctxt "OverlayWindow"
msgid "Scan a picture or screenshot file."
msgstr "Сканировать файл картинки или снимка экрана."

#: ui/overlay.slint:394
msgctxt "OverlayWindow"
msgid "Create QR code…"
msgstr "Создать QR-код…"

#: ui/overlay.slint:395
msgctxt "OverlayWindow"
msgid "Turn a link or text into a QR code to scan with your phone."
msgstr "Превратите ссылку или текст в QR-код для сканирования телефоном."

