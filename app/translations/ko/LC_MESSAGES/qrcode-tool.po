msgid "QRcode tool — Create QR code"
msgstr "QRcode tool — QR 코드 만들기"

#: ui/generator.slint:66
msgctxt "GeneratorWindow"
msgid "Text or link"
msgstr "텍스트 또는 링크"

#: ui/generator.slint:74
msgctxt "GeneratorWindow"
msgid ""
"Type or paste what the code should contain, for example https://example.com"
msgstr "코드에 담을 내용을 입력하거나 붙여 넣으세요(예: https://example.com)"

#: ui/generator.slint:83
msgctxt "GeneratorWindow"
msgid "Error correction"
msgstr "오류 정정"

#: ui/generator.slint:89
msgctxt "GeneratorWindow"
msgid "Low — smallest code"
msgstr "낮음 — 가장 작은 코드"

#: ui/generator.slint:89
msgctxt "GeneratorWindow"
msgid "Medium — recommended"
msgstr "중간 — 권장"

#: ui/generator.slint:89
msgctxt "GeneratorWindow"
msgid "Quartile"
msgstr "높음(25%)"

#: ui/generator.slint:89
msgctxt "GeneratorWindow"
