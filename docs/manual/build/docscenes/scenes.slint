// Scenes for the user manual screenshots. Not part of the app.
// Imports the app's real components from ../ui (baked per language by bake.js).

import { Theme } from "../ui/theme.slint";
import { Icons } from "../ui/icons.slint";
import { ToolbarPanel, BubblePanel } from "../ui/floating_embed.slint";

// ───────────── Mock desktop: wallpaper, a browser with an event page, taskbar ─────────────

component QrCard inherits Rectangle {
    in property <image> qr;
    in property <string> heading;
    in property <string> text;
    in property <color> tag-color: #1D4FFF;
    width: 230px;
    height: 286px;
    background: #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e3e7ef;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #0000001a;
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 6px;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        background: root.tag-color;
    }
    Image {
        x: 30px;
        y: 22px;
        width: 170px;
        height: 170px;
        source: root.qr;
        image-rendering: pixelated;
    }
    Text {
        x: 16px;
        y: 204px;
        width: parent.width - 32px;
        text: root.heading;
        font-size: 16px;
        font-weight: 700;
        color: #1b1b1b;
        horizontal-alignment: center;
    }
    Text {
        x: 16px;
        y: 230px;
        width: parent.width - 32px;
        text: root.text;
        font-size: 12px;
        color: #5b6170;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
}

export component DesktopContent inherits Rectangle {
    in property <image> qr0;
    in property <image> qr1;
    in property <image> qr2;
    in property <image> qr3;
    width: 1280px;
    height: 720px;
    // Wallpaper
    Rectangle {
        background: @linear-gradient(140deg, #0b3a8c 0%, #2a6fdb 45%, #7fb7f5 75%, #d8e9fb 100%);
    }
    Rectangle {
        x: 760px;
        y: -160px;
        width: 760px;
        height: 760px;
        border-radius: 380px;
        background: @radial-gradient(circle, #ffffff40 0%, #ffffff00 70%);
    }

    // Browser window
    Rectangle {
        x: 80px;
        y: 28px;
        width: 1120px;
        height: 620px;
        border-radius: 8px;
        background: #ffffff;
        clip: true;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000055;
        // tab strip
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 40px;
            background: #e8edf5;
            Rectangle {
                x: 10px;
                y: 6px;
                width: 300px;
                height: 34px;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                background: #ffffff;
                Rectangle {
                    x: 12px;
                    y: 9px;
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: @linear-gradient(135deg, #1D4FFF 0%, #19DFC2 100%);
                }
                Text {
                    x: 36px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - 48px;
                    text: @tr("Autumn Technology Seminar 2026");
                    font-size: 12px;
                    color: #1b1b1b;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            for i in 3: Rectangle {
                x: parent.width - 130px + i * 42px;
                y: 13px;
                width: 14px;
                height: 14px;
                border-radius: 2px;
                border-width: 1.5px;
                border-color: #6b7280;
            }
        }
        // address bar
        Rectangle {
            x: 0;
            y: 40px;
            width: parent.width;
            height: 44px;
            background: #ffffff;
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #e3e7ef;
            }
            Rectangle {
                x: 110px;
                y: 7px;
                width: 760px;
                height: 30px;
                border-radius: 15px;
                background: #f1f3f8;
                Image {
                    x: 12px;
                    y: 8px;
                    width: 14px;
                    height: 14px;
                    source: Icons.lock;
                    colorize: #4b5563;
                }
                Text {
                    x: 34px;
                    y: 0;
                    height: parent.height;
                    text: "https://events.example.org/seminar-2026";
                    font-size: 13px;
                    color: #1f2937;
                    vertical-alignment: center;
                }
            }
            for i in 3: Rectangle {
                x: 18px + i * 30px;
                y: 15px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #c4cad6;
            }
        }
        // page
        Rectangle {
            x: 0;
            y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            background: #f6f8fc;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 124px;
                background: @linear-gradient(120deg, #1D4FFF 0%, #159FF0 55%, #19DFC2 100%);
                Text {
                    x: 55px;
                    y: 26px;
                    text: @tr("Autumn Technology Seminar 2026");
                    font-size: 30px;
                    font-weight: 700;
                    color: #ffffff;
                }
                Text {
                    x: 55px;
                    y: 76px;
                    text: @tr("Saturday 14 November · Main Hall, 3rd floor · Free admission");
                    font-size: 15px;
                    color: #ffffffe6;
                }
            }
            QrCard {
                x: 55px;
                y: 150px;
                qr: root.qr0;
                heading: @tr("Register online");
                text: @tr("Scan to fill in the sign-up form.");
                tag-color: #1D4FFF;
            }
            QrCard {
                x: 315px;
                y: 150px;
                qr: root.qr1;
                heading: @tr("Venue Wi-Fi");
                text: @tr("Join the guest network in the hall.");
                tag-color: #0f9d58;
            }
            QrCard {
                x: 575px;
                y: 150px;
                qr: root.qr2;
                heading: @tr("Contact the organizer");
                text: @tr("Save the organizer's details to your contacts.");
                tag-color: #8b5cf6;
            }
            QrCard {
                x: 835px;
                y: 150px;
                qr: root.qr3;
                heading: @tr("Sponsor offer");
                text: @tr("A coupon link from an outside advertiser.");
                tag-color: #f59e0b;
            }
        }
    }

    // Taskbar
    Rectangle {
        x: 0;
        y: parent.height - 48px;
        width: parent.width;
        height: 48px;
        background: #eef1f6f0;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: #00000014;
        }
        for c[i] in [#1D4FFF, #0f9d58, #f59e0b, #ef4444, #8b5cf6]: Rectangle {
            x: (parent.width - 5 * 40px) / 2 + i * 40px + 6px;
            y: 10px;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: c;
            opacity: 0.85;
        }
        Image {
            x: parent.width - 236px;
            y: 15px;
            width: 18px;
            height: 18px;
            source: Icons.chevron-down;
            colorize: #374151;
            transform-rotation: 180deg;
        }
        Image {
            x: parent.width - 204px;
            y: 13px;
            width: 22px;
            height: 22px;
            source: Icons.logo;
        }
        Image {
            x: parent.width - 172px;
            y: 15px;
            width: 18px;
            height: 18px;
            source: Icons.wifi;
            colorize: #374151;
        }
        Text {
            x: parent.width - 130px;
            y: 6px;
            width: 110px;
            text: "10:30";
            font-size: 12px;
            color: #1b1b1b;
            horizontal-alignment: right;
        }
        Text {
            x: parent.width - 130px;
            y: 24px;
            width: 110px;
            text: "2026/11/14";
            font-size: 12px;
            color: #1b1b1b;
            horizontal-alignment: right;
        }
    }
}

export component SceneDesktop inherits Window {
    no-frame: true;
    width: 1280px;
    height: 720px;
    in property <image> qr0;
    in property <image> qr1;
    in property <image> qr2;
    in property <image> qr3;
    DesktopContent {
        qr0: root.qr0;
        qr1: root.qr1;
        qr2: root.qr2;
        qr3: root.qr3;
    }
}

// The floating toolbar (row or column) or the bubble on top of the desktop.
export component SceneFloating inherits Window {
    no-frame: true;
    width: 1280px;
    height: 720px;
    in property <image> qr0;
    in property <image> qr1;
    in property <image> qr2;
    in property <image> qr3;
    // "row", "right", "left" or "bubble"
    in property <string> mode: "row";
    in property <string> hotkey-screen: "Ctrl+Alt+Q";
    in property <string> hotkey-region: "Ctrl+Alt+A";
    in property <string> hotkey-camera: "Ctrl+Alt+W";
    DesktopContent {
        qr0: root.qr0;
        qr1: root.qr1;
        qr2: root.qr2;
        qr3: root.qr3;
    }
    if root.mode == "row": ToolbarPanel {
        x: (root.width - 500px) / 2;
        y: 24px;
        width: 500px;
        height: 80px;
        vertical: false;
        hotkey-screen: root.hotkey-screen;
        hotkey-region: root.hotkey-region;
        hotkey-camera: root.hotkey-camera;
    }
    if root.mode == "right" || root.mode == "left": ToolbarPanel {
        x: root.mode == "right" ? root.width - 64px - 24px : 24px;
        y: (root.height - 576px) / 2;
        width: 64px;
        height: 576px;
        vertical: true;
        hotkey-screen: root.hotkey-screen;
        hotkey-region: root.hotkey-region;
        hotkey-camera: root.hotkey-camera;
    }
    if root.mode == "bubble": BubblePanel {
        x: root.width - 48px - 24px;
        y: root.height * 3 / 5;
        width: 48px;
        height: 48px;
    }
}

// ───────────── Tray menu (native menu, drawn in the Windows 11 style) ─────────────

component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> checked;
    in property <bool> highlighted;
    in property <bool> disabled;
    height: 34px;
    border-radius: 4px;
    background: root.highlighted ? #0000000f : transparent;
    if root.checked: Image {
        x: 12px;
        y: 10px;
        width: 14px;
        height: 14px;
        source: Icons.check;
        colorize: #1b1b1b;
    }
    if !root.checked: Image {
        x: 10px;
        y: 8px;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.disabled ? #00000060 : #1b1b1b;
    }
    Text {
        x: 40px;
        y: 0;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        color: root.disabled ? #00000060 : #1b1b1b;
        vertical-alignment: center;
    }
}

component MenuSep inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: #0000001a;
    }
}

export component SceneTray inherits Window {
    no-frame: true;
    width: 1280px;
    height: 720px;
    in property <image> qr0;
    in property <image> qr1;
    in property <image> qr2;
    in property <image> qr3;
    DesktopContent {
        qr0: root.qr0;
        qr1: root.qr1;
        qr2: root.qr2;
        qr3: root.qr3;
    }
    Rectangle {
        x: root.width - 470px;
        y: root.height - 48px - self.height - 8px;
        width: 290px;
        height: menu.preferred-height;
        background: #f9f9f9;
        border-radius: 8px;
        border-width: 1px;
        border-color: #00000024;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        menu := VerticalLayout {
            padding: 4px;
            spacing: 0px;
            MenuRow {
                icon: Icons.fullscreen;
                text: @tr("Scan whole screen");
                highlighted: true;
            }
            MenuRow {
                icon: Icons.region;
                text: @tr("Select area");
            }
            MenuRow {
                icon: Icons.camera;
                text: @tr("Scan with camera");
            }
            MenuRow {
                icon: Icons.clipboard;
                text: @tr("Scan image from clipboard");
            }
            MenuRow {
                icon: Icons.image;
                text: @tr("Open image…");
            }
            MenuSep { }
            MenuRow {
                icon: Icons.qr;
                text: @tr("Create QR code…");
            }
            MenuRow {
                text: @tr("Floating toolbar");
                checked: true;
            }
            MenuRow {
                text: @tr("Floating bubble");
            }
            MenuSep { }
            MenuRow {
                icon: Icons.history;
                text: @tr("History");
            }
            MenuRow {
                icon: Icons.settings;
                text: @tr("Settings");
            }
            MenuRow {
                text: @tr("Check for updates");
            }
            MenuSep { }
            MenuRow {
                text: @tr("Quit");
            }
        }
    }
    // The tray icon the menu belongs to.
    Rectangle {
        x: root.width - 210px;
        y: root.height - 44px;
        width: 34px;
        height: 40px;
        border-radius: 4px;
        background: #0000000f;
    }
}

// ───────────── Windows right-click menus (classic menu, "Show more options") ─────────────

component ShellRow inherits Rectangle {
    in property <string> text;
    in property <bool> ours;
    in property <bool> submenu;
    in property <bool> highlighted;
    height: 30px;
    border-radius: 4px;
    background: root.highlighted ? #0000000f : transparent;
    if root.ours: Image {
        x: 10px;
        y: 7px;
        width: 16px;
        height: 16px;
        source: Icons.logo;
    }
    Text {
        x: 36px;
        y: 0;
        height: parent.height;
        text: root.text;
        font-size: 13px;
        color: #1b1b1b;
        vertical-alignment: center;
    }
    if root.submenu: Image {
        x: parent.width - 24px;
        y: 9px;
        width: 12px;
        height: 12px;
        source: Icons.chevron-right;
        colorize: #1b1b1b;
    }
}

component ShellSep inherits Rectangle {
    height: 7px;
    Rectangle {
        y: 3px;
        height: 1px;
        background: #0000001a;
    }
}

component ShellMenu inherits Rectangle {
    width: 300px;
    height: list.preferred-height;
    background: #f9f9f9;
    border-radius: 8px;
    border-width: 1px;
    border-color: #00000024;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000040;
    list := VerticalLayout {
        padding: 4px;
        @children
    }
}

// mode: "desktop" (desktop background) or "image" (one selected picture)
export component SceneShellMenu inherits Window {
    no-frame: true;
    width: 1280px;
    height: 720px;
    in property <string> mode: "desktop";
    Rectangle {
        background: @linear-gradient(140deg, #0b3a8c 0%, #2a6fdb 45%, #7fb7f5 75%, #d8e9fb 100%);
    }
    // a few desktop icons, the picture last
    for name[i] in [@tr("Recycle Bin"), @tr("Documents"), "seminar-poster.png"]: Rectangle {
        x: 24px;
        y: 24px + i * 104px;
        width: 88px;
        height: 92px;
        border-radius: 4px;
        background: root.mode == "image" && i == 2 ? #ffffff40 : transparent;
        border-width: root.mode == "image" && i == 2 ? 1px : 0px;
        border-color: #ffffff80;
        Rectangle {
            x: 22px;
            y: 8px;
            width: 44px;
            height: 44px;
            border-radius: 6px;
            background: i == 2 ? #ffffff : i == 1 ? #f5c542 : #d8e1ee;
            if i == 2: Image {
                x: 6px;
                y: 6px;
                width: 32px;
                height: 32px;
                source: Icons.image;
                colorize: #1D4FFF;
            }
        }
        Text {
            x: 2px;
            y: 58px;
            width: parent.width - 4px;
            text: name;
            font-size: 11px;
            color: #ffffff;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if root.mode == "desktop": ShellMenu {
        x: 560px;
        y: 150px;
        ShellRow { text: @tr("View"); submenu: true; }
        ShellRow { text: @tr("Sort by"); submenu: true; }
        ShellRow { text: @tr("Refresh"); }
        ShellSep { }
        ShellRow { text: @tr("New"); submenu: true; }
        ShellSep { }
        ShellRow { text: @tr("Display settings"); }
        ShellRow { text: @tr("Personalize"); }
        ShellSep { }
        ShellRow { text: @tr("QRcode tool Scan screen"); ours: true; highlighted: true; }
        ShellRow { text: @tr("QRcode tool Scan selection"); ours: true; }
        ShellRow { text: @tr("QRcode tool Scan with camera"); ours: true; }
        ShellRow { text: @tr("QRcode tool Toolbar"); ours: true; }
    }
    if root.mode == "image": ShellMenu {
        x: 120px;
        y: 250px;
        ShellRow { text: @tr("Open"); }
        ShellRow { text: @tr("Edit"); }
        ShellRow { text: @tr("Print"); }
        ShellRow { text: @tr("Set as desktop background"); }
        ShellSep { }
        ShellRow { text: @tr("QRcode tool Open image"); ours: true; highlighted: true; }
        ShellSep { }
        ShellRow { text: @tr("Open with"); submenu: true; }
        ShellRow { text: @tr("Copy as path"); }
        ShellSep { }
        ShellRow { text: @tr("Cut"); }
        ShellRow { text: @tr("Copy"); }
        ShellSep { }
        ShellRow { text: @tr("Delete"); }
        ShellRow { text: @tr("Rename"); }
        ShellSep { }
        ShellRow { text: @tr("Properties"); }
    }
}

// ───────────── A phone held up to the webcam ─────────────

export component ScenePhoto inherits Window {
    no-frame: true;
    width: 1280px;
    height: 720px;
    in property <image> qr;
    Rectangle {
        background: @linear-gradient(160deg, #4a4038 0%, #2b2622 60%, #1c1916 100%);
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, #ffffff1c 0%, #00000000 60%);
    }
    // hand / sleeve hint
    Rectangle {
        x: 560px;
        y: 520px;
        width: 260px;
        height: 260px;
        border-radius: 120px;
        background: #c99b7a;
        opacity: 0.9;
    }
    // phone
    Rectangle {
        x: 470px;
        y: 70px;
        width: 340px;
        height: 560px;
        border-radius: 40px;
        background: #111214;
        drop-shadow-blur: 30px;
        drop-shadow-color: #000000aa;
        Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            border-radius: 28px;
            background: #ffffff;
            clip: true;
            Rectangle {
                height: 64px;
                y: 0;
                background: #0f9d58;
                Text {
                    text: @tr("Venue Wi-Fi");
                    color: #ffffff;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Image {
                x: (parent.width - 240px) / 2;
                y: 110px;
                width: 240px;
                height: 240px;
                source: root.qr;
                image-rendering: pixelated;
            }
            Text {
                x: 20px;
                y: 380px;
                width: parent.width - 40px;
                text: @tr("Join the guest network in the hall.");
                font-size: 16px;
                color: #374151;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}

// ───────────── Windows 11 frame around a captured client area ─────────────

export component DocFrame inherits Window {
    no-frame: true;
    in property <image> shot;
    in property <string> caption;
    // client size in logical pixels
    in property <length> client-w: 600px;
    in property <length> client-h: 400px;
    in property <bool> dark: false;
    property <length> pad: 28px;
    property <length> bar: 32px;
    width: root.client-w + 2 * root.pad;
    height: root.client-h + root.bar + 2 * root.pad;
    background: #ffffff;
    Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.client-w;
        height: root.client-h + root.bar;
        border-radius: 8px;
        background: root.dark ? #202020 : #f3f3f3;
        border-width: 1px;
        border-color: root.dark ? #ffffff26 : #0000002e;
        drop-shadow-blur: 22px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000038;
        clip: true;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.bar;
            Image {
                x: 10px;
                y: 8px;
                width: 16px;
                height: 16px;
                source: Icons.logo;
            }
            Text {
                x: 34px;
                y: 0;
                height: parent.height;
                text: root.caption;
                font-size: 12px;
                color: root.dark ? #ffffff : #1b1b1b;
                vertical-alignment: center;
            }
            // minimise, maximise, close
            Rectangle {
                x: parent.width - 138px + 18px;
                y: 16px;
                width: 10px;
                height: 1px;
                background: root.dark ? #ffffff : #1b1b1b;
            }
            Rectangle {
                x: parent.width - 92px + 18px;
                y: 11px;
                width: 10px;
                height: 10px;
                border-width: 1px;
                border-color: root.dark ? #ffffff : #1b1b1b;
            }
            Image {
                x: parent.width - 46px + 16px;
                y: 9px;
                width: 14px;
                height: 14px;
                source: Icons.close;
                colorize: root.dark ? #ffffff : #1b1b1b;
            }
        }
        Image {
            x: 0;
            y: root.bar;
            width: root.client-w;
            height: root.client-h;
            source: root.shot;
            image-fit: fill;
        }
    }
}
