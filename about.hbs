<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>QRcode tool — third-party licenses</title>
<style>body{font-family:system-ui,sans-serif;max-width:960px;margin:2em auto;padding:0 1em}pre{white-space:pre-wrap;background:#f6f6f6;padding:1em}</style></head>
<body><h1>Third-party licenses</h1>
<p>QRcode tool includes the following components.</p>
<ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul>
{{#each licenses}}<h2 id="{{id}}">{{name}}</h2><p>Used by:</p><ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul><pre>{{text}}</pre>{{/each}}
<h2>zxing-cpp (C++)</h2><p>Apache-2.0 — https://github.com/zxing-cpp/zxing-cpp</p>
</body></html>
